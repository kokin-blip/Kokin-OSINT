# Build output
/target/
**/target/
/ui/dist/
/ui/node_modules/
node_modules/

# Generated by tauri-build on every build from tauri.conf.json + the ACL.
# Committing it produces churn and can drift from the config it came from.
/src-tauri/gen/schemas/

# Case data — NEVER commit. Cases contain collected evidence.
*.kokincase
*.kokincase-journal
*.kokincase-wal
/cases/

# Models are downloaded at runtime, never vendored (see docs/dependencies.csv)
/models/
*.onnx
*.gguf
*.traineddata
*.pmtiles

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# OS noise
.DS_Store
Thumbs.db
desktop.ini
