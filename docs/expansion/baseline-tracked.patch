+    let kinds = vec!["stress_path".into()];
+    let cancel = AtomicBool::new(false);
+    let run = || {
+        let view = expand_multi(
+            &open.conn,
+            &seeds,
+            ExpansionOptions {
+                hops: 4,
+                node_limit: 300,
+                per_node: 128,
+                direction: "both",
+                kinds: &kinds,
+            },
+            &cancel,
+        )
+        .unwrap();
+        assert_eq!(view.nodes.len(), 300);
+        assert_eq!(view.edges.len(), 1000);
+        assert!(view.truncation_reasons.iter().any(|r| r == "edge_limit"));
+        assert_eq!(
+            view.nodes
+                .iter()
+                .find(|n| n.id == "ent-298")
+                .unwrap()
+                .canonical_id,
+            "ent-297"
+        );
+        assert!(view
+            .edges
+            .iter()
+            .all(|e| view.nodes.iter().any(|n| n.id == e.from)
+                && view.nodes.iter().any(|n| n.id == e.to)));
+        view.edges.len()
+    };
+    Latencies::measure(
+        "maximum real expansion 300 nodes/1000 edges",
+        Kind::Diagnostic,
+        run,
+    )
+    .report();
+    for direction in ["incoming", "outgoing"] {
+        let view = expand_multi(
+            &open.conn,
+            &["ent-1".into()],
+            ExpansionOptions {
+                hops: 1,
+                node_limit: 40,
+                per_node: 16,
+                direction,
+                kinds: &kinds,
+            },
+            &cancel,
+        )
+        .unwrap();
+        assert!(view.edges.iter().all(|e| if direction == "incoming" {
+            e.to == "ent-1"
+        } else {
+            e.from == "ent-1"
+        }));
+    }
+    assert!(expand_multi(
+        &open.conn,
+        &seeds,
+        ExpansionOptions {
+            hops: 4,
+            node_limit: 300,
+            per_node: 128,
+            direction: "both",
+            kinds: &kinds
+        },
