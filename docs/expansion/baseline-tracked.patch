+    let final_view = expand_multi(
+        &open.conn,
+        &seeds,
+        ExpansionOptions {
+            hops: 4,
+            node_limit: 300,
+            per_node: 128,
+            direction: "both",
+            kinds: &kinds,
+        },
+        &cancel,
